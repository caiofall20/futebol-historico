# ===========================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ===========================================
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commite o arquivo .env no Git!

# Segurança
SECRET_KEY=gerar-nova-chave-secreta-aqui
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# Database (PostgreSQL em produção)
DB_ENGINE=postgresql
DB_NAME=futebol_historico
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui
DB_HOST=localhost
DB_PORT=5432

# Cache (Redis em produção)
REDIS_URL=redis://localhost:6379/1

# Email (para newsletter, etc)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_app
DEFAULT_FROM_EMAIL=noreply@seudominio.com

# Google AdSense (opcional - adicionar após aprovação)
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX

# Google Analytics (opcional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
